{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotspot Guard",
  "version": "0.2.0",
  "identifier": "local.hotspot-guard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hotspot Guard",
        "width": 920,
        "height": 620,
        "minWidth": 760,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Block outbound traffic except an allowlist",
    "longDescription": "Hotspot Guard blocks outbound traffic except the destinations you allow, so a metered hotspot only carries the services you choose.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../hotspot_guard.py": "engine/hotspot_guard.py",
      "../../firewall.py": "engine/firewall.py",
      "../../hotspot-guard.ini": "engine/hotspot-guard.ini",
      "../../usage.py": "engine/usage.py"
    }
  }
}
